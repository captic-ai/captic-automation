# Copy to .env and fill in real values. .env is gitignored; THIS file is committed,
# so it must NEVER contain real credentials, tokens, or webhook keys.

# --- Target + profile -------------------------------------------------
# TARGET_ENV=prod  -> prod_safe profile (read-only smoke only)
# TARGET_ENV=staging -> staging_full profile (broader regression)
TARGET_ENV=prod
TEST_ENVIRONMENT=production
PROD_UI_BASE_URL=https://captic.ai
PROD_API_BASE_URL=https://captic-api-prod-8o8vj.ondigitalocean.app
STAGING_UI_BASE_URL=https://staging.example.com
STAGING_API_BASE_URL=https://api-staging.example.com

# Optional manual overrides. Usually leave these empty and switch only TARGET_ENV.
# UI_BASE_URL=
# API_BASE_URL=

# --- Timeouts / viewport ---------------------------------------------
API_HEALTH_PATH=/health
API_TIMEOUT_SECONDS=20
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# --- Safety switches --------------------------------------------------
ENABLE_DESTRUCTIVE_TESTS=false
ALLOW_UNSAFE_TARGETS=false

# --- Dedicated test account (fill in your real .env, not here) --------
TEST_USER_EMAIL=your-test-account@example.com
TEST_USER_PASSWORD=__set_in_local_env_or_ci_secret__

# --- UI login wiring --------------------------------------------------
UI_LOGIN_PATH=/login
UI_LOGIN_EMAIL_SELECTOR=input[name="email"]
UI_LOGIN_PASSWORD_SELECTOR=input[name="password"]
UI_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
UI_LOGIN_SUCCESS_SELECTOR=[data-testid="dashboard-shell"]

# --- API login wiring -------------------------------------------------
API_LOGIN_PATH=/api/auth/login
API_LOGIN_IDENTIFIER_FIELD=email
API_LOGIN_PASSWORD_FIELD=password
API_LOGIN_EXPECTED_STATUSES=200
API_LOGIN_SUCCESS_FIELD=token
API_LOGIN_EXTRA_PAYLOAD={"rememberMe": true}

# --- Agent coverage (fill in once real Captic agent routes are known) -
# Read-only (prod-safe) endpoints:
AGENT_UI_PATH=/agents
AGENT_API_LIST_PATH=/api/agents
AGENT_API_DETAIL_PATH=/api/agents/{id}
# Data-changing (staging_full only) endpoints:
AGENT_API_RUN_PATH=/api/agents/{id}/runs
AGENT_RUN_POLL_PATH=/api/runs/{id}
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_EXPECTED_RUN_STATUSES=200,201,202

# --- Notifications ----------------------------------------------------
# Set this in CI secrets (or your local .env), NEVER commit a real webhook URL.
GOOGLE_CHAT_WEBHOOK_URL=__set_in_ci_secret__
