TARGET_ENV=prod
TEST_ENVIRONMENT=production
PROD_UI_BASE_URL=https://captic.ai
PROD_API_BASE_URL=https://api.example.com
STAGING_UI_BASE_URL=https://staging.example.com
STAGING_API_BASE_URL=https://api-staging.example.com

# Optional manual overrides. Usually leave these empty and switch only TARGET_ENV.
# UI_BASE_URL=
# API_BASE_URL=

API_HEALTH_PATH=/health
API_TIMEOUT_SECONDS=20
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ENABLE_DESTRUCTIVE_TESTS=false
ALLOW_UNSAFE_TARGETS=false
TEST_USER_EMAIL=test-automation@example.com
TEST_USER_PASSWORD=change-me
UI_LOGIN_PATH=/login
UI_LOGIN_EMAIL_SELECTOR=input[name="email"]
UI_LOGIN_PASSWORD_SELECTOR=input[name="password"]
UI_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
UI_LOGIN_SUCCESS_SELECTOR=[data-testid="dashboard-shell"]
API_LOGIN_PATH=/api/auth/login
API_LOGIN_IDENTIFIER_FIELD=email
API_LOGIN_PASSWORD_FIELD=password
API_LOGIN_EXPECTED_STATUSES=200
API_LOGIN_SUCCESS_FIELD=token
API_LOGIN_EXTRA_PAYLOAD={"rememberMe": true}

# Optional. Set this in CI secrets rather than a local file when possible.
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN
